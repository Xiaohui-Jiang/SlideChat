+/* ROI overlay styles */
+
+.roi-overlay {
+  position: absolute;
+  inset: 0;
+  width: 100%;
+  height: 100%;
+  box-sizing: border-box;
+  transition: all 0.2s ease;
+}
+
+.roi-overlay:hover {
+  border-width: 3px !important;
+  box-shadow: 0 0 10px rgba(16, 185, 129, 0.5);
+}
+
+.roi-overlay.selected {
+  border-color: #ef4444 !important;
+  background: rgba(239, 68, 68, 0.2) !important;
