+}
+
+/* OpenSeadragon and ROI styles */
+#osd-viewer-container {
+  position: relative !important;
+  width: 100% !important;
+  height: 100% !important;
+}
+
+.openseadragon-container {
+  position: absolute !important;
+  top: 0 !important;
+  left: 0 !important;
+  width: 100% !important;
+  height: 100% !important;
+}
+
+.roi-drawing {
+  box-sizing: border-box;
+  pointer-events: none;
+}
+
+.openseadragon-canvas {
+  cursor: crosshair;
+}
+
+.openseadragon-canvas:active {
+  cursor: grabbing;
+}
